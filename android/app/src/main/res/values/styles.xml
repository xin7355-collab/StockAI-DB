<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色底,開啟瞬間不會白閃 -->
    <!-- ⚠️ LauncherActivity 是 AppCompatActivity → parent 必須是 Theme.AppCompat 系列,
         用系統主題會在啟動時丟 IllegalStateException(又一種閃退) -->
    <style name="Theme.LauncherActivity" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:statusBarColor">@color/backgroundColor</item>
        <item name="android:navigationBarColor">@color/backgroundColor</item>
    </style>
</resources>
